# === Pluggy (Open Finance / Meu Pluggy) ===
PLUGGY_CLIENT_ID=00000000-0000-0000-0000-000000000000
PLUGGY_CLIENT_SECRET=replace-with-your-pluggy-client-secret
PLUGGY_ITEM_ID=00000000-0000-0000-0000-000000000000

# === Backend Auth (ADR-003) ===
# Gere uma chave aleatória longa: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
APP_KEY=replace-with-long-random-app-key
WEBHOOK_TOKEN=replace-with-long-random-webhook-token

# === Supabase ===
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_DB_PASSWORD=replace-with-db-password

# === Mobile App (mobile/.env) ===
EXPO_PUBLIC_API_URL=https://your-project-ref.supabase.co/functions/v1/api
EXPO_PUBLIC_APP_KEY=replace-with-long-random-app-key

# === PII Guard (valores locais que nunca podem entrar em commits públicos) ===
# Separados por vírgula; scripts/check-pii.mjs bloqueia qualquer commit que contenha esses trechos
PII_GUARD=
